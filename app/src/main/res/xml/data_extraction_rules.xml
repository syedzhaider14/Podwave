<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12 and higher. Downloaded audio can be fetched again, so it isn't worth the backup quota. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="file" path="episodes/" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="file" path="episodes/" />
    </device-transfer>
</data-extraction-rules>
